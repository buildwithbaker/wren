{
  "name": "wren",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Wren - local-first sticky notes PWA + Chrome extension. Notes stored as .md files on disk.",
  "author": "Adam Baker / Build with Baker",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "dev": "vite",
    "build:pwa": "vite build",
    "build:ext": "vite build --config vite.config.extension.js",
    "build": "node scripts/gen-icons.mjs && vite build && vite build --config vite.config.extension.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "@tiptap/extension-underline": "^2.11.5",
    "@tiptap/extension-text-style": "^2.11.5",
    "@tiptap/extension-color": "^2.11.5",
    "@tiptap/extension-highlight": "^2.11.5",
    "@tiptap/extension-task-list": "^2.11.5",
    "@tiptap/extension-task-item": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "vite": "^5.4.11"
  }
}
