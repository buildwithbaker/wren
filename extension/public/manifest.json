{
  "manifest_version": 3,
  "name": "Wren — Sticky Notes",
  "version": "1.0.0",
  "description": "Local-first sticky notes. Rich-text notes saved as Markdown files in a folder you choose. No cloud, no account.",
  "author": "Adam Baker / Build with Baker",
  "homepage_url": "https://wren.buildwithbaker.io",
  "minimum_chrome_version": "86",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wren",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
