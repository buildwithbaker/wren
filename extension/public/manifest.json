{
  "manifest_version": 3,
  "name": "Scrybe — Sticky Notes",
  "version": "1.0.0",
  "description": "Local-first sticky notes. Rich-text notes saved as Markdown files in a folder you choose. No cloud, no account.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scrybe",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
